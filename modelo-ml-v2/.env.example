# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Modelo ML validado en Colab
MODEL_PATH=modelos/modelo_hibrido/artefacto_modelo.pkl
MODEL_VERSION=

# Madurez mínima de la serie
MIN_WEEKS_XGBOOST=26
MIN_WEEKS_HYBRID=84

# Reentrenamiento
RETRAIN_SECRET=
ENABLE_AUTOMATIC_RETRAIN=false

# Frontend autorizado. En Cloud Run usar la URL real de Vercel.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
